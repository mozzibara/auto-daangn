[Unit]
Description=Auto Daangn OCI v5 signed ingestion database health (metadata only)
After=local-fs.target

[Service]
Type=oneshot
User=daangn
Group=daangn
WorkingDirectory=/opt/auto-daangn
# Global private-state lock keeps the 1 GB OCI host from running backup, intake
# and health jobs together; contention is bounded and recorded by systemd.
ExecStart=/usr/bin/flock -w 20 /var/lib/auto-daangn/db/oci-ops.lock /opt/auto-daangn/.venv/bin/python -m ops.oci.runtime status --state-dir /var/lib/auto-daangn
Environment=PYTHONUTF8=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/auto-daangn
RestrictAddressFamilies=AF_UNIX
MemoryMax=256M
TasksMax=20

[Install]
WantedBy=multi-user.target
